cp /root/rt/prework/tf_ol.tfvars terraform-upcloud/terraform.tfvars
bash evaluation/l4/harness/cluster.sh up && for a in $(seq 1 4); do bash evaluation/l4/harness/cluster.sh cpu | tee /tmp/cpu.txt; . evaluation/l4/harness/lib.sh; awk -v ip=${SPUB[0]} '$1==ip {f=1; if ($(NF-1) > 0.40) exit 1} END {if (!f) exit 1}' /tmp/cpu.txt && exit 0; echo "slow scheduler, replacing it (attempt $a)"; (cd terraform-upcloud && terraform destroy -auto-approve -input=false -no-color -target=upcloud_server.scheduler | tail -1; sleep 90; terraform apply -auto-approve -input=false -no-color | tail -1); sleep 30; bash evaluation/l4/harness/cluster.sh up > /dev/null; done; exit 1
bash scripts/2_setup.sh -m cloud 5 5 > /root/rt/prework/n8_setup.log 2>&1; r=$?; tail -3 /root/rt/prework/n8_setup.log; exit $r
bash evaluation/l4/harness/kernel.sh
bash evaluation/l4/harness/matrix.sh prep
bash evaluation/l4/harness/cluster.sh health
RELOAD_MS= bash evaluation/l4/harness/matrix.sh run pilot_s8 evaluation/l4/harness/arms/pilot.txt 1
python3 evaluation/l4/harness/gate.py pilot results/l4/pilot_s8
bash /root/rt/prework/pilot_ladder.sh 8 && bash evaluation/l4/harness/mkarms_ibm.sh $(cat /root/rt/prework/replay_mean) final rq3 conn3 loss4 pad4 agelimit
MAXFAIL=5 EXEMPT='random' bash evaluation/l4/harness/matrix.sh run final_ibm8 evaluation/l4/harness/arms/final_ibm.txt 5 && bash evaluation/l4/harness/matrix.sh fill final_ibm8 evaluation/l4/harness/arms/final_ibm.txt 5 && { python3 evaluation/l4/harness/arms_check.py results/l4/final_ibm8 5 | tail -25; true; }
RELOAD_MS= bash evaluation/l4/harness/matrix.sh run ref_s8_1 evaluation/l4/harness/arms/ref.txt 1; python3 evaluation/l4/harness/gate.py ref results/l4/pilot_s8 results/l4/ref_s8_1 || true
MAXFAIL=5 EXEMPT='random' bash evaluation/l4/harness/matrix.sh run final_paper8 evaluation/l4/harness/arms/final.txt 5 && bash evaluation/l4/harness/matrix.sh fill final_paper8 evaluation/l4/harness/arms/final.txt 5 && { python3 evaluation/l4/harness/arms_check.py results/l4/final_paper8 5 | tail -25; true; }
RELOAD_MS= bash evaluation/l4/harness/matrix.sh run ref_s8_2 evaluation/l4/harness/arms/ref.txt 1; python3 evaluation/l4/harness/gate.py ref results/l4/pilot_s8 results/l4/ref_s8_2 || true
MAXFAIL=5 EXEMPT='jsq|random|hashed' bash evaluation/l4/harness/matrix.sh run rq3_ibm8 evaluation/l4/harness/arms/rq3_ibm.txt 5 && bash evaluation/l4/harness/matrix.sh fill rq3_ibm8 evaluation/l4/harness/arms/rq3_ibm.txt 5 && { python3 evaluation/l4/harness/arms_check.py results/l4/rq3_ibm8 5 | tail -25; true; }
RELOAD_MS= bash evaluation/l4/harness/matrix.sh run ref_s8_3 evaluation/l4/harness/arms/ref.txt 1; python3 evaluation/l4/harness/gate.py ref results/l4/pilot_s8 results/l4/ref_s8_3 || true
