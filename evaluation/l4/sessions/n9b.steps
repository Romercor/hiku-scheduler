cp /root/rt/prework/tf_ol.tfvars terraform-upcloud/terraform.tfvars
bash evaluation/l4/harness/cluster.sh up && for a in $(seq 1 4); do bash evaluation/l4/harness/cluster.sh cpu | tee /tmp/cpu.txt; . evaluation/l4/harness/lib.sh; awk -v ip=${SPUB[0]} '$1==ip {f=1; if ($(NF-1) > 0.40) exit 1} END {if (!f) exit 1}' /tmp/cpu.txt && exit 0; echo "slow scheduler, replacing it (attempt $a)"; (cd terraform-upcloud && terraform destroy -auto-approve -input=false -no-color -target=upcloud_server.scheduler | tail -1; sleep 90; terraform apply -auto-approve -input=false -no-color | tail -1); sleep 30; bash evaluation/l4/harness/cluster.sh up > /dev/null; done; exit 1
bash scripts/2_setup.sh -m cloud 5 5 > /root/rt/prework/n9b_setup.log 2>&1; r=$?; tail -3 /root/rt/prework/n9b_setup.log; exit $r
bash evaluation/l4/harness/kernel.sh
bash evaluation/l4/harness/matrix.sh prep
bash evaluation/l4/harness/cluster.sh health
RELOAD_MS= bash evaluation/l4/harness/matrix.sh run pilot_s9b evaluation/l4/harness/arms/pilot.txt 1
python3 evaluation/l4/harness/gate.py pilot results/l4/pilot_s9b
{ [ -s /root/rt/prework/replay_mean ] || bash /root/rt/prework/pilot_ladder.sh 9b; } && bash evaluation/l4/harness/mkarms_ibm.sh $(cat /root/rt/prework/replay_mean) conn3 loss4 pad4 agelimit
bash evaluation/l4/harness/matrix.sh run final_ibm8_r2 evaluation/l4/harness/arms/final_ibm.txt 1 2; true
bash evaluation/l4/harness/matrix.sh run agelimit_ibm9b evaluation/l4/harness/arms/agelimit_ibm.txt 3 && bash evaluation/l4/harness/matrix.sh fill agelimit_ibm9b evaluation/l4/harness/arms/agelimit_ibm.txt 3 && { python3 evaluation/l4/harness/arms_check.py results/l4/agelimit_ibm9b 3 | tail -25; true; }
RELOAD_MS= bash evaluation/l4/harness/matrix.sh run ref_s9b_2 evaluation/l4/harness/arms/ref.txt 1; python3 evaluation/l4/harness/gate.py ref results/l4/pilot_s9b results/l4/ref_s9b_2 || true
MAXFAIL=5 bash evaluation/l4/harness/matrix.sh run skew3_9b evaluation/l4/harness/arms/skew3.txt 12 && bash evaluation/l4/harness/matrix.sh fill skew3_9b evaluation/l4/harness/arms/skew3.txt 12 && { python3 evaluation/l4/harness/arms_check.py results/l4/skew3_9b 12 | tail -25; true; }
MAXFAIL=5 bash evaluation/l4/harness/matrix.sh run top_9b evaluation/l4/harness/arms/top40.txt 5 && bash evaluation/l4/harness/matrix.sh fill top_9b evaluation/l4/harness/arms/top40.txt 5 && { python3 evaluation/l4/harness/arms_check.py results/l4/top_9b 5 | tail -25; true; }
RELOAD_MS= bash evaluation/l4/harness/matrix.sh run ref_s9b_3 evaluation/l4/harness/arms/ref.txt 1; python3 evaluation/l4/harness/gate.py ref results/l4/pilot_s9b results/l4/ref_s9b_3 || true
bash evaluation/l4/harness/matrix.sh run open3_9b evaluation/l4/harness/arms/open3.txt 6 && bash evaluation/l4/harness/matrix.sh fill open3_9b evaluation/l4/harness/arms/open3.txt 6 && { python3 evaluation/l4/harness/arms_check.py results/l4/open3_9b 6 | tail -25; true; }
RELOAD_MS= bash evaluation/l4/harness/matrix.sh run ref_s9b_4 evaluation/l4/harness/arms/ref.txt 1; python3 evaluation/l4/harness/gate.py ref results/l4/pilot_s9b results/l4/ref_s9b_4 || true
